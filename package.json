{
  "name": "csgrad",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "sync-translations": "node --input-type=module scripts/sync-translations.js",
    "check:seo": "node scripts/seo-audit.mjs build --baseline scripts/seo-audit-baseline.txt",
    "test:seo": "node --test scripts/seo-audit.test.mjs",
    "test:analytics": "node --test src/lib/analytics/events.test.mjs",
    "test:migration": "node --test scripts/migration-integrity.test.mjs",
    "test:gpa-filter": "node --test src/lib/dp/gpa-filter.test.mjs",
    "test:ux": "node --test scripts/locale-navigation.test.mjs src/lib/tracker/*.test.mjs src/lib/dp/page-regressions.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@docusaurus/core": "3.8.1",
    "@docusaurus/preset-classic": "3.8.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "d3-geo": "^3.1.1",
    "html2pdf.js": "^0.14.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.8.1",
    "@docusaurus/types": "3.8.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "allowScripts": {
    "core-js": false,
    "core-js-pure": false,
    "fsevents@2.3.3": true
  }
}
